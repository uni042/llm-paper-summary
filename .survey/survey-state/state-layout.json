{
  "schema_version": 1,
  "workflow_version": 8,
  "layout": "cycle-state-v1",
  "management_root": ".survey/",
  "legacy_snapshot": ".survey/survey-state/exploration-state.json",
  "paths": {
    "cycle_state": ".survey/survey-state/cycle-state.json",
    "cycle_plans_dir": ".survey/survey-state/cycle-plans/",
    "cycle_history_dir": ".survey/survey-state/cycle-history/",
    "progress_deltas_dir": ".survey/survey-state/progress-deltas/",
    "runtime": ".survey/survey-state/runtime.json",
    "legacy_daily_plans_dir": ".survey/survey-state/daily-plans/",
    "research_queue": ".survey/survey-state/queues/research.json",
    "audit_queue": ".survey/survey-state/queues/audit.json",
    "identity_index": ".survey/survey-state/paper-identity-index.json",
    "identity_deltas_dir": ".survey/survey-state/identity-deltas/",
    "retry_papers": ".survey/survey-state/retry-papers.json",
    "rejected_papers": ".survey/survey-state/rejected-papers.json",
    "maintenance_queue": ".survey/survey-state/maintenance-queue.json",
    "blockers": ".survey/survey-state/blockers.json",
    "leases": ".survey/survey-state/leases.json",
    "runs_dir": ".survey/survey-state/runs/",
    "logs_dir": ".survey/survey-state/log/",
    "integrity_dir": ".survey/survey-state/integrity/",
    "frozen_training": ".survey/survey-state/frozen-training.json",
    "status_page": ".survey/survey-state/STATUS.md",
    "workflow_docs": ".survey/docs/survey-workflow/",
    "scripts": ".survey/scripts/",
    "tests": ".survey/tests/",
    "templates": ".survey/templates/"
  },
  "migration": {
    "from_workflow_version": 7,
    "to_workflow_version": 8,
    "legacy_progress_preserved": true,
    "current_plan_selection_treated_as_cycle_run_1": true,
    "management_tree_hidden_under": ".survey/",
    "note": "Workflow v8 uses GitHub-persisted run counts. Moving management files under .survey is layout-only and does not add completed readings or audits."
  }
}
